{
  "version": 2,
  "functions": {
    "api/server.js": { "memory": 256, "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/server.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
