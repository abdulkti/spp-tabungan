# REST API mode (Vercel): gunakan Supabase REST API (IPv4 compatible)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Direct mode (local): gunakan connection string langsung (butuh IPv6)
# DATABASE_URL=postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres

JWT_SECRET=your-jwt-secret-key-change-this
